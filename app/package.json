{
  "name": "emoji-cipher-app",
  "version": "1.0.0",
  "private": true,
  "description": "Android wrapper for the Emoji Cipher (Capacitor). The web page itself lives at ../index.html.",
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});fs.copyFileSync('../index.html','www/index.html')\"",
    "sync": "npm run copy-web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
